<?xml version="1.0"?>
<model>
  <name>aruco_marker</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Anshul Kumar Paliwal</name>
  </author>

  <description>
    Flat ArUco marker plate for the corvid project. DICT_4X4_50, id 0.
    Plate is 0.192 m square; the marker itself is 0.144 m across, with a
    white quiet zone making up the rest. Use 0.144 m as the marker length
    for pose estimation.
  </description>
</model>
